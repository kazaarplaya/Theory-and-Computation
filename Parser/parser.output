Grammar

    0 $accept: program $end

    1 program: class_declaration_list

    2 class_declaration_list: class_declaration class_declaration_list
    3                       | ε

    4 class_declaration: CLASS IDENTIFIER '{' member_list '}' ';'

    5 member_list: member_declaration member_list
    6            | ε

    7 member_declaration: visibility var_declaration
    8                   | visibility function_declaration
    9                   | visibility class_declaration

   10 visibility: PUBLIC
   11           | PRIVATE
   12           | PROTECTED

   13 type: INT
   14     | CHAR
   15     | IDENTIFIER

   16 var_declaration: type IDENTIFIER ';'
   17                | type IDENTIFIER '=' expression ';'
   18                | type IDENTIFIER '=' new_expression ';'

   19 function_declaration: type IDENTIFIER '(' function_parameters ')' block
   20                     | VOID IDENTIFIER '(' function_parameters ')' block

   21 function_parameters: parameter parameter_list_tail
   22                    | ε

   23 parameter_list_tail: ',' parameter parameter_list_tail
   24                    | ε

   25 parameter: type IDENTIFIER

   26 block: '{' statement_list '}'

   27 statement_list: statement statement_list
   28               | ε

   29 statement: var_declaration
   30          | assignment ';'
   31          | return_statement
   32          | if_statement
   33          | while_statement
   34          | for_statement
   35          | do_statement
   36          | delete_statement ';'
   37          | block

   38 assignment: IDENTIFIER '=' expression
   39           | IDENTIFIER '=' new_expression

   40 return_statement: RETURN ';'
   41                 | RETURN expression ';'

   42 if_statement: IF '(' expression ')' block
   43             | IF '(' expression ')' block ELSE block

   44 while_statement: WHILE '(' expression ')' block

   45 for_statement: FOR '(' for_initialisation ';' expression ';' for_update ')' block

   46 for_initialisation: ε
   47                   | assignment
   48                   | type IDENTIFIER '=' expression
   49                   | type IDENTIFIER

   50 for_update: ε
   51           | assignment
   52           | IDENTIFIER "++"
   53           | IDENTIFIER "--"

   54 do_statement: DO block WHILE '(' expression ')' ';'

   55 new_expression: NEW type
   56               | NEW type '[' expression ']'

   57 delete_statement: DELETE IDENTIFIER
   58                 | DELETE '[' ']' IDENTIFIER

   59 expression: additive_expression

   60 additive_expression: term additive_tail

   61 additive_tail: '+' term additive_tail
   62              | '-' term additive_tail
   63              | ε

   64 term: factor term_tail

   65 term_tail: '*' factor term_tail
   66          | '/' factor term_tail
   67          | '%' factor term_tail
   68          | ε

   69 factor: IDENTIFIER
   70       | INTEGER
   71       | CHARACTER
   72       | '(' expression ')'


